{
  "name": "dsh-liya-skin-plugin",
  "version": "0.5.2",
  "description": "莉娅 DSH 皮肤插件：壁纸（wallpapers/ 缩略图选择 + 透明度滑条 + host 持久化）+ 莉娅星月皮肤层（星月装饰/标题栏品牌/状态投影，卸载全还原）；皮肤层开关走 settings 配置卡，保存即时生效。v0.4.1 修复 settingsScope 重复 bind 导致皮肤层开关永不生效的坑。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./skin.json": "./skin.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "skin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.2.1-rc.2"
  }
}
